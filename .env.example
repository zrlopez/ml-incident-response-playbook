# ============================================================
# .env.example — ml-incident-response-playbook
#
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in every value marked REQUIRED before starting
#   3. Never commit .env to source control
#   4. In production, inject all values via your secrets manager
#      (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager)
# ============================================================

# ── API Authentication ────────────────────────────────────────────────────────
# PRODUCTION: RS256 asymmetric signing is the primary algorithm.
# Set RSA_PRIVATE_KEY_PEM and RSA_PUBLIC_KEY_PEM (see bottom of this file).
# JWT_ALGORITHM below is the dev/CI HS256 fallback only — do NOT use in production.
#
# JWT_ALGORITHM=HS256  # dev/CI fallback only — RS256 is active in production

# REQUIRED (dev/CI HS256 fallback): Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Access token expiry in minutes (default: 30; recommend 15 for sensitive ops)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiry in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── RS256 JWT Signing Keys (REQUIRED for production) ──────────────────────────
# RS256 asymmetric signing is the active production algorithm.
# Generate a key pair: python -m src.auth.jwt_rs256
# Store output in your secrets manager — NEVER in .env or git.
# Leave unset in dev/CI to fall back to HS256.
#
# RSA_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...
# RSA_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...  (optional; derived from private)
# RSA_OLD_PUBLIC_KEY_PEM=...  (set during key rotation window; clear after 24h)

# ── API Configuration ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Deployment environment: development | staging | production
# NOTE: Setting ENVIRONMENT=production disables /docs and /redoc Swagger UI.
ENVIRONMENT=development

# ── Redis (JWT denylist backing store) ──────────────────────────────────
# Format: redis://[:password@]host[:port][/db-number]
# TLS:    rediss://user:pass@hostname:6380/0
REDIS_PASSWORD=REPLACE_WITH_64_CHAR_RANDOM_HEX
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ── Alerting ───────────────────────────────────────────────────────────────
# REQUIRED: Receives incident alert emails from the Airflow DAG
ALERT_EMAIL=oncall@yourorg.com

# Optional: Slack Incoming Webhook URL for dual-channel incident alerting
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ── Airflow ───────────────────────────────────────────────────────────────
# Deployment environment tag (used in DAG metadata and alerts)
AIRFLOW_ENV=development

# Fernet key for Airflow connection/variable encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_FERNET_KEY

# ── Database (production PostgreSQL) ────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ml_incidents

# ── Observability ──────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# OpenTelemetry trace exporter endpoint (OTLP gRPC)
# Standalone (outside Compose): http://localhost:4317
# Inside docker-compose:        http://otel-collector:4317  ← Compose overrides this automatically
# Set OTEL_SDK_DISABLED=true to turn off tracing in local dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ml-incident-api
# OTEL_SDK_DISABLED=true

# ── Development user credentials (CRIT-A REMEDIATION — ALL REQUIRED) ────────────────────
# These replace the previous hard-coded stub passwords in api/app.py.
# The API will REFUSE TO START if any value below is empty or matches
# the placeholder. Generate each with: openssl rand -hex 16
# NEVER reuse these values across environments.
DEV_ADMIN_PASSWORD=REPLACE_WITH_SECURE_RANDOM_VALUE
DEV_ANALYST_PASSWORD=REPLACE_WITH_SECURE_RANDOM_VALUE
DEV_OPERATOR_PASSWORD=REPLACE_WITH_SECURE_RANDOM_VALUE

# ── Request hardening (middleware.py) ──────────────────────────────────────────────
# Maximum request body size in bytes (default: 1048576 = 1 MB)
# Increase for file-upload endpoints only; do NOT raise the global default.
# MAX_BODY_SIZE_BYTES=1048576

# Request timeout in seconds before HTTP 504 is returned (default: 30)
# REQUEST_TIMEOUT_SECONDS=30

# ── Phase 3: ARCH-02 argon2-cffi migration window ─────────────────────────────
# Set to 'false' once all users have been rehashed to argon2id.
# Monitor progress: SELECT hash_algorithm, COUNT(*) FROM users GROUP BY 1;
# Remove passlib+bcrypt from requirements.txt when this is 'false'.
ALLOW_BCRYPT_FALLBACK=false

# ── Phase 3: ARCH-07 per-user rate limiting (Redis sliding window) ───────────
# Requests per window (60s default) by role. Override to tune per environment.
# RATE_LIMIT_ADMIN=300
# RATE_LIMIT_OPERATOR=200
# RATE_LIMIT_ANALYST=100
# RATE_LIMIT_DEFAULT=60
# RATE_LIMIT_WINDOW_SECONDS=60
# Fail closed on Redis outage? false = allow requests, true = return 503
# RATE_LIMIT_FAIL_CLOSED=false

# ── Phase 3: DATABASE_URL (ARCH-03 PostgresUserRepository) ────────────────────
# Required for production. Alembic also reads this for migrations.
# Run migrations before starting the API: alembic upgrade head
# Seed users after migration: python scripts/seed_users.py
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ml_incidents
# Dev SQLite fallback (no user repo persistence):
# DATABASE_URL=sqlite+aiosqlite:///./incidents.db
