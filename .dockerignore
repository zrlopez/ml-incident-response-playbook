# =============================================================================
# .dockerignore — prevent sensitive/unnecessary files from entering build context
# =============================================================================

# Version control
.git
.gitignore
.github

# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Python artifacts
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
.eggs/

# Virtual environments
.venv
venv
env

# Test suite — never in production image
tests/
test_*
*_test.py
.pytest_cache
.coverage
htmlcov/
coverage.xml

# Development tools
.mypy_cache
.ruff_cache
.bandit

# Documentation
docs/
runbooks/
diagrams/
README.md
*.md

# IDE
.vscode
.idea
*.iml

# macOS
.DS_Store

# CI/CD configs (not needed in image)
ci_cd/
Makefile

# Infrastructure configs
infrastructure/
