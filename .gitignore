# ──────────────────────────────────────────────────────────────────────────────
# .gitignore — ML Incident Response Platform
# ──────────────────────────────────────────────────────────────────────────────

# ── macOS ─────────────────────────────────────────────────────────────────────
**/.DS_Store
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
._*

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Build / distribution ──────────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.whl
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets and environment files ─────────────────────────────────────────────
# .env.example is intentionally committed; actual .env files are not
.env
.env.local
.env.staging
.env.production
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
jwt_private.pem
jwt_public.pem

# ── Testing artifacts ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
*.cover

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.iml
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
*.jsonl

# ── Database files ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Docker ────────────────────────────────────────────────────────────────────
# Root Dockerfile is retired. Use infrastructure/Dockerfile.hardened.
Dockerfile

# ── dbt ───────────────────────────────────────────────────────────────────────
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ── Airflow ───────────────────────────────────────────────────────────────────
airflow.cfg
airflow.db
airflow/logs/
airflow/plugins/
standalone_admin_password.txt

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── SBOM / security scan outputs ─────────────────────────────────────────────
sbom.spdx.json
trivy-results.sarif
bandit-report.json

# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
