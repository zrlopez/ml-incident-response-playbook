# ──────────────────────────────────────────────────────────────────────────────
# .gitignore — ML Incident Response Platform
# LOW-A REMEDIATION: Added .DS_Store, expanded secret exclusions,
# resolved merge conflicts from prior stash.
# ──────────────────────────────────────────────────────────────────────────────

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Build / distribution ──────────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets and environment files ─────────────────────────────────────────────
# NEVER commit real .env files. .env.example is intentionally tracked.
.env
*.env
.env.local
.env.staging
.env.production
.env.production.local
!.env.example

# ── JWT keys and TLS certificates (never commit) ──────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
.secrets/

# ── macOS filesystem artifacts — LOW-A REMEDIATION ────────────────────────────
# These binaries expose directory listings and extended attributes.
# If already tracked: git rm -r --cached .DS_Store && git commit -m "remove .DS_Store"
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml
.cursor/

# ── Testing and coverage ──────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
pytest_results*.md
.coverage_report*.txt
.tox/
*.cover

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb_checkpoints

# ── Local databases (never bake into VCS or images) ───────────────────────────
*.db
*.sqlite
*.sqlite3

# ── SBOM output (generated artifacts, not source) ─────────────────────────────
sbom*.json
sbom*.spdx
*.sarif

# ── Session tracking docs (internal only, never for public consumption) ────────
# MAT_*.md files live at the local GitHub root folder, not inside any repo.
MAT_*.md

# NOTE: .dockerignore is intentionally tracked — it protects image build context
# and should be reviewed alongside Dockerfile changes.
node_modules/
package-lock.json
cosign.key
