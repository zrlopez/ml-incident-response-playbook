  init: {
    'theme': 'base',
    'themeVariables': {
      'primaryColor': '#1e293b',
      'primaryTextColor': '#f8fafc',
      'primaryBorderColor': '#475569',
      'lineColor': '#94a3b8'
    }
  }
}%%
flowchart TD
    A(["🔴 ALERT: Pipeline Failure\nPipelineSLABreach or Airflow DAG failure"])
    A --> B["Check Airflow UI / logs\nIdentify the failed task and error class"]

    B --> C{"Source system\nreachable?"}
    C -- "No" --> D["Escalate to upstream system owner\nPause dependent downstream DAGs\nSet DAG: paused=True in Airflow UI"]
    C -- "Yes" --> E{"Schema or contract\nchange detected?"}

    E -- "Yes" --> F["Review schema diff\nCheck dbt schema.yml and sources.yml\nUpdate transformation + tests"]
    E -- "No" --> G{"Credentials / auth\nexpired?"}

    G -- "Yes" --> H["Rotate credentials in Vault\nUpdate K8s Secret\nRestart affected pods"]
    G -- "No" --> I{"Timeout or\nresource saturation?"}

    I -- "Yes" --> J["Increase task timeout in DAG\nor scale worker resources\nCheck Airflow celery queue depth"]
    I -- "No" --> K["Inspect Python stacktrace\nCheck dependency versions\nCheck upstream data quality"]

    F --> L["Run full validation suite\ndbt test + custom data quality checks\nApprove for controlled backfill"]
    H --> L
    J --> L
    K --> L
    D --> L

    L --> M{"All validation\nchecks passed?"}
    M -- "No" --> N(["🚨 BLOCK PIPELINE\nEngage data engineering lead\nDo NOT backfill with invalid data"])
    M -- "Yes" --> O["Trigger approved re-run\nMonitor Airflow task completion\nWatch for retry storms"]

    O --> P{"Pipeline completes\nwithout errors?"}
    P -- "No" --> N
    P -- "Yes" --> Q["Verify row counts vs expected\nConfirm downstream consumers unaffected\nCheck dbt fct_incident_summary"]
    Q --> R["Log recovery timeline in ticket\nAssign preventive action items\nDocument root cause"]
    R --> S(["✅ RESOLVE INCIDENT\nUpdate ticket: status=resolved\nSchedule postmortem if SEV-1/2"])

    style A fill:#dc2626,color:#fff,stroke:#991b1b
    style N fill:#ea580c,color:#fff,stroke:#c2410c
    style S fill:#16a34a,color:#fff,stroke:#15803d
