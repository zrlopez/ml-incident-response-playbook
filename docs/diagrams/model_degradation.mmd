flowchart TD
    A(["🔴 ALERT: Model Degradation\nml_model_accuracy_p95 < 0.92"])
    A --> B{"Alert verified?\nCheck Grafana: Model Health dashboard"}

    B -- "Noise / flapping" --> B1(["✅ Close alert\nDocument as false positive\nin #ml-ops-alerts"])
    B -- "Confirmed breach" --> C["Assign Incident Commander\nOpen #ml-incidents-sev{N}\nNotify @ml-platform-sre"]

    C --> D{"Deployment\nin last 4 hours?\nkubectl rollout history"}

    D -- "Yes" --> E["Compare pre/post metrics\nIdentify offending version"]
    D -- "No" --> F["Check drift_ratio\nand feature distributions\nvia Grafana: Drift dashboard"]

    E --> G{"Regression\nconfirmed?"}
    F --> G

    G -- "Deployment regression" --> H["kubectl rollout undo\ndeployment/ml-inference-api\nNotify team in incident channel"]
    G -- "Data/feature drift" --> I["Engage feature pipeline owner\nFreeze upstream schema changes\nCheck monitoring/drift_check.py"]
    G -- "Unclear" --> J["Expand investigation:\nlabel quality, preprocessing,\ndependency changes, infra"]

    H --> K{"SLO restored\nafter rollback?\nAccuracy ≥ 0.92 for 5 min"}
    I --> K
    J --> K

    K -- "Yes" --> L["Monitor for 15 consecutive minutes\nSend stakeholder update\nEvery 15 min if SEV-1"]
    K -- "No, SEV-1 threshold" --> M(["🚨 ESCALATE\nML Platform Lead + VP Engineering\nActivate SEV-1 bridge channel"])
    K -- "No, SEV-2" --> N["Engage model owner\nfor deeper root cause analysis"]

    N --> K

    L --> O{"Stable for\n15+ consecutive minutes?"}
    O -- "No, degraded again" --> D
    O -- "Yes" --> P["Document full timeline\nAssign preventive action items\nwith owners + due dates"]
    P --> Q(["✅ RESOLVE INCIDENT\nUpdate ticket: status=resolved\nSchedule postmortem within 48h"])

    style A fill:#dc2626,color:#fff,stroke:#991b1b
    style B1 fill:#16a34a,color:#fff,stroke:#15803d
    style M fill:#ea580c,color:#fff,stroke:#c2410c
    style Q fill:#16a34a,color:#fff,stroke:#15803d
