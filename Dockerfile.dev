# Dockerfile.dev — Development image
# =====================================
# NOT FOR PRODUCTION USE. This image is intentionally lighter than the
# production Dockerfile — it includes development tools (pytest, debugpy,
# hot-reload) and uses a pinned slim image rather than Alpine.
#
# Supply-chain posture:
#   - Base image is pinned by SHA-256 digest (same discipline as production).
#   - Unlike production, we keep apt-get upgrade for developer convenience
#     (reduces local CVE noise during active development).
#   - No Cosign attestation, no SBOM — dev image is never pushed to a
#     production registry. If your workflow pushes this image anywhere,
#     promote the production Dockerfile instead.
#
# To update the digest:
#   docker pull python:3.11-slim
#   docker inspect python:3.11-slim --format '{{index .RepoDigests 0}}'
#   Update the SHA below and commit.
#
# Current digest pinned: python:3.11-slim @ sha256 (2026-08-05)
# Verify: docker manifest inspect python:3.11-slim@sha256:<digest>

FROM python:3.11-slim@sha256:c6b60d7c5bf2b4c67b4f5e57e9e8c06e7e01a36b4561e3b56c3e9f2c62f3dbf1 AS dev
# ^ NOTE: Replace the sha256 above with the real digest from:
#   docker pull python:3.11-slim && docker inspect --format '{{index .RepoDigests 0}}' python:3.11-slim
#   The value above is a placeholder that documents the pinning pattern.
#   In a real team setup, automate digest refreshes via Renovate or Dependabot.

WORKDIR /app

# Install system dependencies (dev-only: includes build tools for wheels)
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt requirements-dev.txt* ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && if [ -f requirements-dev.txt ]; then pip install --no-cache-dir -r requirements-dev.txt; fi

# Copy application source
COPY . .

# Development server with hot reload
# Override CMD at runtime for other dev tasks (pytest, debugpy, etc.)
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
