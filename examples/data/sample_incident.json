  "root_cause": {
    "summary": "Upstream feature pipeline (fraud-features-daily) ingested a corrupted merchant category encoding table deployed at 2026-05-22T02:00:00Z. This caused merchant_category_encoded to collapse 47 distinct categories into 12, sharply shifting the feature distribution vs. training baseline.",
    "contributing_factors": [
      "No schema validation on encoding table ingestion",
      "dbt model did not assert distinct count on merchant_category_encoded",
      "Drift monitoring alert threshold had not been reviewed since model v2.x"
    ],
    "blast_radius": "142,800 inference requests over ~28 hours returned degraded precision scores"
  },

  "remediation": {
    "immediate": [
      "Rolled back fraud-features-daily pipeline to 2026-05-21T02:00:00Z snapshot",
      "Re-served affected batch with corrected features",
      "Disabled auto-deploy for encoding table updates pending schema gate"
    ],
    "rollback_reference": "fraud-features-daily@sha256:a3f1b8c",
    "follow_up": [
      "Add dbt assert: distinct(merchant_category_encoded) >= 40",
      "Add schema contract validation on encoding table ingestion (OPEN-05)",
      "Lower drift alert threshold from 0.15 to 0.10 for production fraud model",
      "Schedule model retraining with May data by 2026-06-10"
    ]
  },

