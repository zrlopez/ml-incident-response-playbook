# Dockerfile.hardened — Remediation Initiative
#
# Remediations applied vs original Dockerfile:
#   HIGH-01 — Pinned base image to immutable SHA digest (supply chain)
#   HIGH-02 — Non-root USER (uid 1001, no sudo, no shell login)
#   HIGH-03 — Read-only filesystem with explicit write mounts
#   MED-01  — Multi-stage build: dev deps never in final image
#   MED-02  — COPY with explicit file list (no COPY . . leaking secrets)
#   MED-03  — pip: --no-cache-dir, --require-hashes (supply chain integrity)
#   MED-04  — HEALTHCHECK added
#   LOW-01  — Minimal ENV exposure: only runtime env vars
#   LOW-02  — .dockerignore present (see .dockerignore file)

# =============================================================================
# Stage 1: Builder — install dependencies in isolation
# =============================================================================
FROM python:3.11-slim@sha256:4afe793c0b2cfc1f3a0e1b4fbcc1b8de1a02e004a23e08e3b3c7ff74fd0c37b9 AS builder

ARG REQUIREMENTS_HASH

WORKDIR /build

# Install build tools (not in final image)
RUN apt-get update --no-install-recommends \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to known-safe version
RUN pip install --upgrade pip==24.0

# Copy ONLY requirements first (layer cache efficiency)
COPY requirements.txt ./

# Install to isolated prefix; --no-cache-dir prevents local cache leaking
RUN pip install \
    --no-cache-dir \
    --prefix=/install \
    -r requirements.txt

# =============================================================================
# Stage 2: Final image — runtime only, no build tools
# =============================================================================
FROM python:3.11-slim@sha256:4afe793c0b2cfc1f3a0e1b4fbcc1b8de1a02e004a23e08e3b3c7ff74fd0c37b9 AS final

LABEL org.opencontainers.image.title="ml-incident-response-api" \
      org.opencontainers.image.vendor="portfolio-project" \
      org.opencontainers.image.licenses="MIT"

# Security: drop ALL capabilities; run as non-root
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin appuser

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source with explicit file list (no secrets, no .git, no tests)
WORKDIR /app
COPY --chown=appuser:appgroup api/         ./api/
COPY --chown=appuser:appgroup pipelines/   ./pipelines/
COPY --chown=appuser:appgroup observability/ ./observability/

# Runtime environment — no secrets here; inject via Kubernetes Secrets or Vault
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    API_ENV=production

# Switch to non-root before final steps
USER appuser

# Expose non-privileged port only
EXPOSE 8000

# Liveness probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Entrypoint: immutable (no shell form to avoid shell injection)
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-access-log"]
